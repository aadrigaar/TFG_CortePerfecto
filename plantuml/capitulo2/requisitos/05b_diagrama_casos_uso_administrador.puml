@startuml
title Casos de uso del administrador - Corte Perfecto
left to right direction
skinparam shadowing false
skinparam roundcorner 12
skinparam UsecaseBorderColor #16324F
skinparam UsecaseBackgroundColor #F8FBFF
skinparam ActorBorderColor #16324F

actor "Administrador\n(Peluquero)" as Admin

rectangle "Sistema Corte Perfecto" {
  package "Acceso" {
    usecase "UC-10\nIniciar sesión\nadministrador" as UC10
    usecase "UC-17\nCerrar sesión" as UC17
  }

  package "Consulta" {
    usecase "UC-11\nVer dashboard" as UC11
    usecase "UC-12\nListar, filtrar y\nordenar citas" as UC12
  }

  package "Gestión de citas" {
    usecase "UC-13\nCrear cita manual" as UC13
    usecase "UC-14\nEditar cita" as UC14
    usecase "UC-15\nMarcar cita\ncompletada" as UC15
    usecase "UC-16\nEliminar cita" as UC16
  }
}

Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17
@enduml
