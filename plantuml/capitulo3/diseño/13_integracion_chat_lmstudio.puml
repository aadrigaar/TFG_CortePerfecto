@startuml
title Diseño de integración cliente-chatbot-LM Studio
scale max 1250 width
skinparam shadowing false
skinparam roundcorner 12
actor Cliente
boundary "Frontend React\nChatWidget + chatApi" as Front
control "chatController\nExpress" as Ctrl
control "bookingFlowService\nreglas, contexto y decisión" as Flow
control "lmStudioService\nprompt + llamada local" as IA
control "appointmentService\nagenda y solapes" as AppointmentService
database "MongoDB\nappointments" as Mongo
control "LM Studio\nMeta Llama 3.1 8B" as LM

Cliente -> Front : escribe mensaje
Front -> Front : añadir mensaje y bajar al final
Front -> Ctrl : POST /api/chat\nmessage, history, conversationId
Ctrl -> Flow : intentar flujo determinista
alt datos suficientes para cita
  Flow -> AppointmentService : crear/actualizar cita
  AppointmentService -> Mongo : persistir Appointment
  Mongo --> AppointmentService : documento guardado
  AppointmentService --> Flow : cita válida
  Flow --> Ctrl : respuesta + appointment
else conversación natural
  Flow -> IA : construir system prompt\nfecha, hora, historial, catálogo
  IA -> LM : HTTP /v1/chat/completions
  alt LM Studio disponible
    LM --> IA : texto generado
    IA --> Flow : mensaje + candidato JSON parseado
    Flow -> AppointmentService : validar candidato si existe
    AppointmentService --> Flow : cita válida o error de negocio
    Flow --> Ctrl : respuesta final
  else timeout o servidor caído
    IA --> Flow : AppError LMSTUDIO_UNAVAILABLE
    Flow --> Ctrl : mensaje de reintento\nsin guardar cita
  end
end
Ctrl --> Front : JSON {reply, saved, appointment}
Front --> Cliente : mensaje y tarjeta si procede
@enduml
