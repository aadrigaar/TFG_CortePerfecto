@startuml
title Diagrama de Contexto y Navegación - Corte Perfecto

skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F7FAFC
  BorderColor #1F4D78
  FontColor #0B2545
  ArrowColor #475467
  StartColor #1F4D78
  EndColor #1F4D78
}
skinparam note {
  BackgroundColor #FFFCF2
  BorderColor #C9A13A
}

[*] --> WEB_PUBLICA : Cliente accede a la web

state WEB_PUBLICA {
  [*] --> INICIO
  INICIO --> SERVICIOS : Consultar servicios y precios
  SERVICIOS --> COMBOS : Consultar combinaciones
  COMBOS --> NOSOTROS : Conocer la peluquería
  NOSOTROS --> OPINIONES : Consultar opiniones
  OPINIONES --> CONTACTO : Ver ubicación y horario
  CONTACTO --> INICIO : Volver al inicio

  INICIO --> CHATBOT : Reservar con IA
  SERVICIOS --> CHATBOT : Reservar servicio
  COMBOS --> CHATBOT : Reservar pack
}

state CHATBOT {
  [*] --> CONVERSACION
  CONVERSACION --> INFORMACION : Consultar horario / servicios
  INFORMACION --> CONVERSACION : Continuar conversación
  CONVERSACION --> DATOS_RESERVA : Quiere reservar
  DATOS_RESERVA --> VALIDANDO_CITA : Nombre + servicio + fecha + hora
  VALIDANDO_CITA --> PROPONER_ALTERNATIVA : Fin de semana / hora inválida / solape
  PROPONER_ALTERNATIVA --> DATOS_RESERVA : Cliente elige alternativa
  VALIDANDO_CITA --> CITA_CONFIRMADA : Cita válida
  CITA_CONFIRMADA --> [*]
}

CHATBOT --> API_NODE_EXPRESS : Validar reglas y registrar cita
API_NODE_EXPRESS --> CHATBOT : Confirmación o alternativa

WEB_PUBLICA --> LOGIN_ADMIN : Peluquero accede a /admin/login

state PANEL_ADMIN {
  [*] --> DASHBOARD
  DASHBOARD --> GESTION_CITAS : Ver todas
  GESTION_CITAS --> FILTRAR_ORDENAR : Filtrar / ordenar por día
  FILTRAR_ORDENAR --> GESTION_CITAS : Actualizar listado
  GESTION_CITAS --> EDITAR_CITA : Modificar cita
  EDITAR_CITA --> GESTION_CITAS : Guardar cambios
  GESTION_CITAS --> COMPLETAR_CITA : Marcar completada
  COMPLETAR_CITA --> GESTION_CITAS : Refrescar agenda
  GESTION_CITAS --> ELIMINAR_CITA : Eliminar cita
  ELIMINAR_CITA --> GESTION_CITAS : Refrescar agenda
  DASHBOARD --> CREAR_CITA : Crear cita manual
  CREAR_CITA --> GESTION_CITAS : Cita creada
  DASHBOARD --> [*] : Cerrar sesión
  GESTION_CITAS --> [*] : Cerrar sesión
  CREAR_CITA --> [*] : Cerrar sesión
}

LOGIN_ADMIN --> PANEL_ADMIN : Credenciales válidas
LOGIN_ADMIN --> LOGIN_ADMIN : Credenciales inválidas
PANEL_ADMIN --> API_NODE_EXPRESS : Consultar / crear / modificar / eliminar citas

state API_NODE_EXPRESS {
  [*] --> RUTAS_REST
  RUTAS_REST --> CONTROLADORES : Recibir peticiones
  CONTROLADORES --> SERVICIOS : Aplicar reglas de negocio
  SERVICIOS --> MODELOS_MONGOOSE : Persistencia
}

API_NODE_EXPRESS --> LM_STUDIO : Solicitar respuesta conversacional
LM_STUDIO --> API_NODE_EXPRESS : Respuesta IA local
API_NODE_EXPRESS --> MONGODB : Leer y escribir documentos

state MONGODB {
  [*] --> APPOINTMENTS
  [*] --> ADMINS
  [*] --> SERVICIOS
}

state LM_STUDIO {
  [*] --> LLAMA_31_8B
}

note right of CHATBOT
LM Studio aporta conversación natural.
El backend valida reglas críticas:
- nombre real
- servicio 1..7
- lunes a viernes
- 10:00 a 20:00
- cita futura
- sin solapes
end note

note bottom of PANEL_ADMIN
El administrador/peluquero gestiona
la agenda persistida en MongoDB.
end note

@enduml
